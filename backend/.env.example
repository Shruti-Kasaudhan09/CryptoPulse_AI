# Copy to .env (or set these in Render/Railway's dashboard)

# Local dev default is SQLite. For Supabase: Project Settings -> Database ->
# Connection string (URI). Use the "Session pooler" string on free plans.
DATABASE_URL=postgresql+psycopg2://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Your Vercel URL(s), comma-separated. *.vercel.app previews are allowed automatically.
CORS_ORIGINS=http://localhost:5173,https://cryptopulse-ai.vercel.app

# Optional: where data/ and saved_models/ live (defaults to ../ml)
# CRYPTOPULSE_ML_DIR=/app/ml

# ---- Ask CryptoPulse AI assistant (optional) ----
# Without a key the assistant still works in offline mode.
# Free keys: Gemini -> https://aistudio.google.com/apikey
#            Groq   -> https://console.groq.com/keys
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# ---- Accounts (Sign in / Sign up) ----
# Secret used to sign login tokens. Set a long random value in production.
# Locally it is generated automatically into backend/.secret_key.
# JWT_SECRET=
